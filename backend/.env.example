# AI Venture Studio — Backend Configuration (ECC Universal Edition)

PROJECT_NAME="AI Venture Studio Backend"
PORT=8000
DEBUG=true
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Default LLM Provider: 'ollama' (Local Free Mode) or 'cloud' / 'groq' / 'gemini' / 'nvidia'
DEFAULT_LLM_PROVIDER="ollama"
PREFER_LOCAL_OLLAMA=true

# Local Ollama Settings (Free / Offline Qwen3-8B)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

# Multi-Cloud LLM Keys (Optional - Supports Comma-Separated Key Rotation Pools)
GROQ_API_KEYS=""
NVIDIA_NIM_API_KEYS=""
GEMINI_API_KEYS=""

# Live Web Search (Optional - Uses cached SME data if not provided)
TAVILY_API_KEY=""

# Supabase (Optional - Falls back to local SQLite if empty)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Local Vector Storage & Database Paths
CHROMA_DB_PATH="./data/chroma_db"
SQLITE_DB_PATH="./data/venture_studio.db"
UPLOAD_DIR="./data/uploads"
KNOWLEDGE_BASE_PATH="./knowledge_base"
